{
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}" },
  "tasks": [
    {
      "label": "1. 데이터 반영 (npm run data)",
      "type": "process",
      "command": "node",
      "args": ["tools/sync-data.js"],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "2. 그림 카드 만들기 (npm run cards)",
      "type": "process",
      "command": "node",
      "args": ["tools/make-cards.js"],
      "problemMatcher": []
    },
    {
      "label": "3. 활동지 만들기 (npm run worksheets)",
      "type": "process",
      "command": "node",
      "args": ["tools/build-worksheets.js"],
      "problemMatcher": []
    },
    {
      "label": "4. 선생님용 PPT 만들기 (npm run slides)",
      "type": "process",
      "command": "node",
      "args": ["tools/build-slides.js"],
      "problemMatcher": []
    },
    {
      "label": "전부 다시 만들기 (npm run build)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "2. 그림 카드 만들기 (npm run cards)",
        "1. 데이터 반영 (npm run data)",
        "3. 활동지 만들기 (npm run worksheets)",
        "4. 선생님용 PPT 만들기 (npm run slides)"
      ],
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "처음 준비 (npm install)",
      "type": "process",
      "command": "npm.cmd",
      "args": ["install"],
      "problemMatcher": []
    }
  ]
}
